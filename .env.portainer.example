# Stack-Env für den Portainer-Stack 'opensax'.
# In Portainer: Stack-Detail → Editor → Environment variables → "Load
# variables from .env file" → diesen Inhalt einkippen. Portainer legt das
# intern als stack.env ab.

# ─── Pflicht ───────────────────────────────────────────────────────────

# Öffentliche URL der Web-App. Muss exakt das sein, was der NPM ausliefert
# (Schema + Host, ohne Trailing-Slash).
ORIGIN=https://opensax.example.de

# Öffentliche URL des Euro-Office DocumentServer (NPM-Vhost auf
# lernsax-onlyoffice:80). Wird vom Browser geladen, muss von außen
# erreichbar sein.
ONLYOFFICE_PUBLIC_URL=https://office.example.de

# Schlüssel für die symmetrische Verschlüsselung der LernSax-Anmeldedaten
# in /app/data/sessions/*.json. 32 Bytes = 64 Hex-Zeichen.
#   openssl rand -hex 32
LERNSAX_WEB_SESSION_KEY=REPLACE_ME_64_HEX_CHARS

# JWT-Secret zwischen unserer Web-App und dem DocumentServer (Euro-Office;
# die ONLYOFFICE_*-Namen bleiben aus Kompatibilität).
# 32+ Zeichen, identisch in beiden Containern.
#   openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=REPLACE_ME_64_HEX_CHARS

# ─── Optional ──────────────────────────────────────────────────────────

# Falls der MCP unter einer anderen WEB_ORIGIN auf 401-Responses verweisen
# soll (z. B. wenn die MCP-Subdomain != ORIGIN). Default = ORIGIN.
# WEB_ORIGIN=https://opensax.example.de

# Apps, die OpenSax als Login nutzen (siehe README → Anmelden mit OpenSax).
# OPENSAX_OAUTH_CLIENTS=[{"client_id":"lessionsummary","client_secret":"REPLACE_ME","client_name":"LessionSummary","redirect_uris":["https://summary.example.de/auth/callback"],"scopes":["openid","profile","school"],"trusted":true}]

# Interne URL, mit der der DocumentServer unsere Callbacks erreicht. Default
# stimmt, solange die Container-Namen unverändert bleiben.
# WEB_INTERNAL_URL=http://lernsax-web:3000
# OO_INTERNAL_HOST=lernsax-onlyoffice

# Anzahl Reverse-Proxies vor den Containern, die X-Forwarded-For ergänzen
# (DEPLOY.md → Client IPs). Nur NPM davor: 1. Cloudflare + NPM: 2.
# TRUSTED_PROXY_HOPS=1

# Tag der Images ghcr.io/palmarhealer/opensax-{web,mcp}. Die CI pusht bei
# jedem Push auf main `latest` und `sha-<voller Commit-SHA>`; für einen
# Rollback hier einen SHA-Tag eintragen.
# OPENSAX_TAG=latest

# Leitet allen LernSax-Verkehr (JSON-RPC, WebDAV, Datei-Downloads,
# OnlyOffice-Login) über einen HTTP-CONNECT-Proxy auf einem deutschen
# Tailscale-Node — LernSax sieht dann dessen IP statt der des Deployments.
# Setup: deploy/relay/README.md. Ohne Wert geht der Verkehr direkt raus.
# LERNSAX_PROXY_URL=http://100.x.y.z:8888

# Feedback aus dem Avatar-Menü geht als JSON-POST an diese URL (z. B. ein
# n8n-Webhook, der weiter zu GitHub, Nextcloud, Mail … verteilt). Das Secret
# kommt im Header X-OpenSax-Secret mit. Nur wenn beide gesetzt sind, gibt es
# den Eintrag im Menü; ist der Webhook nicht erreichbar, landen Meldungen unter
# /app/data/feedback. Siehe DEPLOY.md → Feedback.
# FEEDBACK_WEBHOOK_URL=https://n8n.example.com/webhook/opensax-feedback
# FEEDBACK_WEBHOOK_SECRET=<openssl rand -hex 32>

# Tag von ghcr.io/euro-office/documentserver. Default steht gepinnt in
# docker-compose.yml; hier überschreiben, um ein neues Release zu testen.
# EUROOFFICE_TAG=v9.3.4-hotfix.1
