# ── Web ────────────────────────────────────────────────────────────────
# 32+ char secret to encrypt stored credentials & sessions on disk
LERNSAX_WEB_SESSION_KEY=replace-this-via-openssl-rand-hex-32
# Public origin of the web app (cookie scope + OAuth issuer + MCP host).
# The MCP must live under <WEB_ORIGIN>/mcp.
WEB_ORIGIN=https://app.example.com

# ── OnlyOffice ─────────────────────────────────────────────────────────
# Long random — must match between lernsax-web and the DocumentServer
ONLYOFFICE_JWT_SECRET=replace-this-via-openssl-rand-hex-32
# Public URL the user's browser uses to load OnlyOffice's api.js
ONLYOFFICE_PUBLIC_URL=https://office.example.com

# ── Network binding ────────────────────────────────────────────────────
# Restrict published ports to a single interface (typically a private/VPN
# IP that only your reverse proxy can reach). Leave at 0.0.0.0 to bind to
# all interfaces.
BIND_HOST=0.0.0.0

# ── MCP ────────────────────────────────────────────────────────────────
LERNSAX_MCP_IDLE_TTL_MS=300000

# ── LernSax egress relay ───────────────────────────────────────────────
# Route all LernSax-bound traffic (JSON-RPC, WebDAV, file downloads,
# OnlyOffice web login) through an HTTP CONNECT proxy, so LernSax sees the
# relay's IP instead of the deployment's. See deploy/relay/README.md.
# Leave unset to talk to LernSax directly.
# LERNSAX_PROXY_URL=http://100.x.y.z:8888
